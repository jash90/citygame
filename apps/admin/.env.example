# HTTP API: leave NEXT_PUBLIC_API_URL empty to use the same-origin proxy
# (Next.js rewrites /api/* to BACKEND_URL server-side). This lets the admin
# work over LAN, on phones, and behind ITP without cross-origin cookie issues.
NEXT_PUBLIC_API_URL=

# Backend host the Next.js server proxies /api/* to.
BACKEND_URL=http://localhost:3003

# WebSocket: connects directly to the backend host. Vercel cannot proxy
# WebSocket upgrades to an external host through rewrites, so the client
# must reach the backend directly. Locally point this at the backend too.
NEXT_PUBLIC_WS_URL=http://localhost:3003

# Production examples:
# BACKEND_URL=https://citygame-api-production.up.railway.app
# NEXT_PUBLIC_WS_URL=https://citygame-api-production.up.railway.app
