# Production endpoints (used when __DEV__ is false — i.e. EAS prod / TestFlight builds).
# Must be https://; iOS ATS blocks plain http to non-localhost domains.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WS_URL=

# Local-dev endpoints (used when __DEV__ is true — i.e. Expo dev client / Metro).
# Must use the EXPO_PUBLIC_ prefix or Expo will not include them in the bundle.
# Backend on localhost:3003 (see apps/backend/.env PORT=3003).
EXPO_PUBLIC_LOCAL_API_URL=
EXPO_PUBLIC_LOCAL_WS_URL=

# MapLibre vector tile style URL. If unset, falls back to MapLibre demo tiles
# (basic global view, NOT a real city map and NOT cacheable for offline packs).
# Public free options that work without an API key:
#   https://tiles.openfreemap.org/styles/liberty   (OSM-derived, recommended)
#   https://api.maptiler.com/maps/streets/style.json?key=YOUR_KEY  (paid)
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Google Maps SDK key (iOS + Android; injected by app.config.ts).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
